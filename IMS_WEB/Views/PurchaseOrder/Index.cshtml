@model IEnumerable<DTOs.PurchaseOrders.PurchaseOrderDto>

@{
    ViewData["Title"] = "Purchase Orders";
    var selectedStatus = ViewBag.SelectedStatus as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Purchase Orders</h2>
        <small class="text-muted">Manage your procurement and orders from suppliers</small>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("WarehouseStaff"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Create Purchase Order</a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter Bar -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Status</label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Draft" selected="@(selectedStatus == "Draft")">Draft</option>
                    <option value="Submitted" selected="@(selectedStatus == "Submitted")">Submitted</option>
                    <option value="Received" selected="@(selectedStatus == "Received")">Received</option>
                    <option value="Cancelled" selected="@(selectedStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Supplier</label>
                <select name="supplierId" asp-items="ViewBag.Suppliers" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Suppliers</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Search</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm"
                       placeholder="Search by supplier, warehouse, user..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Orders Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>PO #</th>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th>Destination Warehouse</th>
                        <th class="text-center">Items</th>
                        <th class="text-end">Total Amount</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No purchase orders found matching criteria.</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <strong>#PO-@order.Id.ToString("D5")</strong>
                            </td>
                            <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td><strong>@order.SupplierName</strong></td>
                            <td>
                                <span class="badge bg-light text-dark border">@order.DestinationWarehouseName</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@order.Items.Count</span>
                            </td>
                            <td class="text-end fw-bold">@order.TotalAmount.ToString("C")</td>
                            <td class="text-center">
                                @switch (order.Status)
                                {
                                    case "Draft":
                                        <span class="badge bg-secondary">Draft</span>
                                        break;
                                    case "Submitted":
                                        <span class="badge bg-primary">Submitted</span>
                                        break;
                                    case "Received":
                                        <span class="badge bg-success">Received</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-info text-dark">@order.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info">View Details</a>
                                @if (order.Status == "Draft" && (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("WarehouseStaff")))
                                {
                                    <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary ms-1">Edit</a>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">
        Total: <strong>@Model.Count()</strong> purchase orders
    </div>
</div>
