@model ProductDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">@Model.Name</h2>
        <code class="text-muted">@Model.SKU</code>
    </div>
    <div>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary me-2">Edit</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="row">
    <!-- Left: Core Details -->
    <div class="col-md-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">Product Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Product Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">SKU</dt>
                    <dd class="col-sm-8"><code>@Model.SKU</code></dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">@Model.CategoryName</span></dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Right: Pricing & Stock -->
    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">Pricing</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-6">Purchase Price</dt>
                    <dd class="col-sm-6">@Model.PurchasePrice.ToString("C")</dd>

                    <dt class="col-sm-6">Selling Price</dt>
                    <dd class="col-sm-6">@Model.SellingPrice.ToString("C")</dd>

                    <dt class="col-sm-6">Margin</dt>
                    <dd class="col-sm-6 text-success fw-bold">@((Model.SellingPrice - Model.PurchasePrice).ToString("C"))</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">Stock Status</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-7">Total On Hand</dt>
                    <dd class="col-sm-5">
                        <span class="fw-bold fs-5 @(Model.IsLowStock ? "text-danger" : "text-success")">
                            @Model.Quantity
                        </span>
                    </dd>

                    <dt class="col-sm-7">Reorder Level</dt>
                    <dd class="col-sm-5">@Model.ReorderLevel</dd>

                    <dt class="col-sm-7">Stock Alert</dt>
                    <dd class="col-sm-5">
                        @if (Model.IsLowStock && Model.IsActive)
                        {
                            <span class="badge bg-warning text-dark">⚠ Low Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success">OK</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <div class="card shadow-sm border-warning">
                <div class="card-header fw-semibold text-warning">Actions</div>
                <div class="card-body d-flex gap-2">
                    @if (Model.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Deactivate this product?')">
                            <button type="submit" class="btn btn-warning btn-sm">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Reactivate" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Reactivate this product?')">
                            <button type="submit" class="btn btn-success btn-sm">Reactivate</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
