@model UpdateProductRequest

@{
    ViewData["Title"] = "Edit Product";
    var productId = (int)ViewData["ProductId"]!;
    var productName = ViewData["ProductName"]?.ToString();
    var productSKU = ViewData["ProductSKU"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Edit: @productName</h2>
        <code class="text-muted">@productSKU</code>
        <small class="text-muted ms-2">(SKU cannot be changed)</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@productId" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-12 mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="PurchasePrice" class="form-label fw-semibold">Purchase Price <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PurchasePrice" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="SellingPrice" class="form-label fw-semibold">Selling Price <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="SellingPrice" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="ReorderLevel" class="form-label fw-semibold">Reorder Level</label>
                    <input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
                    <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                </div>
                <div class = "col-md-4 mb-3">
                    <label asp-for="Quantity" class ="form-label fw-semibold"> Quantity</label>
                    <input asp-for="Quantity" type="number" min="0" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Details" asp-route-id="@productId" class="btn btn-outline-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
