@model IEnumerable<DTOs.Suppliers.SupplierDto>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Suppliers</h2>
        <small class="text-muted">Manage your supplier directory</small>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add New Supplier</a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th class="text-center">Purchase Orders</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No suppliers found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td><strong>@supplier.Name</strong></td>
                            <td>@(supplier.Email ?? "—")</td>
                            <td>@(supplier.Phone ?? "—")</td>
                            <td>@(supplier.Address ?? "—")</td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@supplier.PurchaseOrderCount</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-primary ms-1">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@supplier.Id" method="post" class="d-inline ms-1"
                                          onsubmit="return confirm('Delete supplier \'@supplier.Name\'? This cannot be undone.')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
