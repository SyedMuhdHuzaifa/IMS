@model DTOs.SalesOrders.SalesOrderDto

@{
    ViewData["Title"] = $"Sales Order #SO-{Model.Id:D5}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Sales Order #SO-@Model.Id.ToString("D5")</h2>
        <small class="text-muted">Order Date: @Model.OrderDate.ToString("MMMM dd, yyyy")</small>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Orders</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Order Status Banner & Actions -->
<div class="card shadow-sm mb-4 border-0 bg-light">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted fw-semibold">Current Status:</span>
            @switch (Model.Status)
            {
                case "Draft":
                    <span class="badge bg-secondary fs-6">Draft</span>
                    break;
                case "Submitted":
                    <span class="badge bg-primary fs-6">Submitted (Pending Shipment)</span>
                    break;
                case "Shipped":
                    <span class="badge bg-success fs-6">Shipped & Fulfilled</span>
                    break;
                case "Cancelled":
                    <span class="badge bg-danger fs-6">Cancelled</span>
                    break;
                default:
                    <span class="badge bg-info text-dark fs-6">@Model.Status</span>
                    break;
            }
        </div>

        <div class="d-flex gap-2">
            @if (Model.Status == "Draft")
            {
                <form asp-action="Submit" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Submit this order for fulfillment?')">
                    <button type="submit" class="btn btn-primary btn-sm">Submit Order</button>
                </form>
            }
            @if (Model.Status == "Submitted")
            {
                <form asp-action="Ship" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Ship this order? This will deduct physical stock from the warehouse.')">
                    <button type="submit" class="btn btn-success btn-sm">Ship & Deduct Stock</button>
                </form>
            }
            @if (Model.Status == "Draft" || Model.Status == "Submitted")
            {
                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Cancel this sales order?')">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Cancel Order</button>
                    </form>
                }
            }
        </div>
    </div>
</div>

<div class="row">
    <!-- Order Info Summary -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold bg-white">Customer & Warehouse</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted">Customer:</dt>
                    <dd class="col-sm-7 fw-bold">@Model.CustomerName</dd>

                    <dt class="col-sm-5 text-muted">Warehouse:</dt>
                    <dd class="col-sm-7">@Model.SourceWarehouseName</dd>

                    <dt class="col-sm-5 text-muted">Created By:</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.CreatedByUserName) ? "System" : Model.CreatedByUserName)</dd>

                    <dt class="col-sm-5 text-muted">Order Total:</dt>
                    <dd class="col-sm-7 fs-5 fw-bold text-success">@Model.TotalAmount.ToString("C")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Line Items Table -->
    <div class="col-md-8 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold bg-white d-flex justify-content-between align-items-center">
                <span>Order Items (@Model.Items.Count)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>SKU</th>
                                <th>Product</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><code>@item.SKU</code></td>
                                <td><strong>@item.ProductName</strong></td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                <td class="text-end fw-semibold">@item.LineTotal.ToString("C")</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot class="table-group-divider">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Grand Total:</td>
                                <td class="text-end fw-bold text-success fs-6">@Model.TotalAmount.ToString("C")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
