@model IEnumerable<DTOs.SalesOrders.SalesOrderSummaryDto>

@{
    ViewData["Title"] = "Sales Orders";
    var selectedStatus = ViewBag.SelectedStatus as string;
    var selectedCustomer = ViewBag.SelectedCustomerId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Sales Orders</h2>
        <small class="text-muted">Manage customer orders, fulfillment, and shipments</small>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("WarehouseStaff"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Create Sales Order</a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters Bar -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Status</label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Draft" selected="@(selectedStatus == "Draft")">Draft</option>
                    <option value="Submitted" selected="@(selectedStatus == "Submitted")">Submitted</option>
                    <option value="Shipped" selected="@(selectedStatus == "Shipped")">Shipped</option>
                    <option value="Cancelled" selected="@(selectedStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Customer</label>
                <select name="customerId" asp-items="ViewBag.Customers" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Customers</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset Filters</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Warehouse</th>
                        <th class="text-center">Items</th>
                        <th class="text-end">Total Amount</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No sales orders found matching criteria.</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <strong>#SO-@order.Id.ToString("D5")</strong>
                            </td>
                            <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.CustomerName</td>
                            <td><span class="badge bg-light text-dark border">@order.SourceWarehouseName</span></td>
                            <td class="text-center">@order.ItemCount</td>
                            <td class="text-end fw-bold">@order.TotalAmount.ToString("C")</td>
                            <td class="text-center">
                                @switch (order.Status)
                                {
                                    case "Draft":
                                        <span class="badge bg-secondary">Draft</span>
                                        break;
                                    case "Submitted":
                                        <span class="badge bg-primary">Submitted</span>
                                        break;
                                    case "Shipped":
                                        <span class="badge bg-success">Shipped</span>
                                        break;
                                    case "Cancelled":
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-info text-dark">@order.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-info">View Details</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">
        Total: <strong>@Model.Count()</strong> sales orders
    </div>
</div>
