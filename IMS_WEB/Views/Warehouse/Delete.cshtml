@model DTOs.Warehouses.WarehouseDto

@{
    ViewData["Title"] = "Delete Warehouse";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-danger">Delete Warehouse</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white fw-semibold">
        Warning: Are you sure you want to delete this warehouse?
    </div>
    <div class="card-body">
        <div class="alert alert-warning mb-4" role="alert">
            <strong>Notice:</strong> This action cannot be undone. If this warehouse contains stock or transaction records, deletion may be rejected by the system.
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">Warehouse Name</dt>
            <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9"><code>@Model.Code</code></dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Location) ? "—" : Model.Location)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
