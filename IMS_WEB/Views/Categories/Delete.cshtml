@model DTOs.Categories.CategoryDto

@{
    ViewData["Title"] = "Delete Category";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-danger">Delete Category</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white fw-semibold">
        Warning: Are you sure you want to delete this category?
    </div>
    <div class="card-body">
        @if (Model.ProductCount > 0)
        {
            <div class="alert alert-warning mb-4" role="alert">
                <strong>Notice:</strong> This category currently has <strong>@Model.ProductCount</strong> product(s) linked to it. 
                Deleting it may fail if products still depend on it.
            </div>
        }

        <dl class="row mb-0">
            <dt class="col-sm-3">Category Name</dt>
            <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</dd>

            <dt class="col-sm-3">Linked Products</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.ProductCount</span></dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4">
            <button type="submit" class="btn btn-danger">Confirm Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
