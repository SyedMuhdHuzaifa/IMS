@model IEnumerable<DTOs.Categories.CategoryDto>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Categories</h2>
        <small class="text-muted">Manage product categories and inventory classifications</small>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add New Category</a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 25%;">Category Name</th>
                        <th>Description</th>
                        <th class="text-center" style="width: 15%;">Products</th>
                        <th class="text-end" style="width: 25%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No categories found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>
                                <strong>@category.Name</strong>
                            </td>
                            <td>@(string.IsNullOrEmpty(category.Description) ? "—" : category.Description)</td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@category.ProductCount</span>
                                @if (category.ProductCount > 0)
                                {
                                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id" 
                                       class="btn btn-sm btn-link text-decoration-none p-0 ms-1" title="View products in this category">
                                        View
                                    </a>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary ms-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">
        Total: <strong>@Model.Count()</strong> categories
    </div>
</div>
