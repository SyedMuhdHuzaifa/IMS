@model DTOs.Categories.CategoryDto

@{
    ViewData["Title"] = Model.Name + " - Category Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">@Model.Name</h2>
        <small class="text-muted">Category Details</small>
    </div>
    <div>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary me-2">Edit</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">Category Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</dd>

                    <dt class="col-sm-3">Total Products</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-info text-dark fs-6">@Model.ProductCount</span>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.Id" class="btn btn-sm btn-outline-primary ms-2">
                            Browse Products in this Category
                        </a>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>
