@IMS_API_HostAddress = http://localhost:5062

### ===================================================================
### 1. AUTHENTICATION & IDENTITY
### ===================================================================

### 1.1 Login as Default Admin
# Use Case: Authenticate as the Super Admin to obtain full system privileges.
# @name adminLogin
POST {{IMS_API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "userNameOrEmail": "admin",
  "password": "AdminPassword123!"
}

### Store Admin Tokens
@adminToken = {{adminLogin.response.body.token}}
@adminRefreshToken = {{adminLogin.response.body.refreshToken}}


### 1.2 Login as Manager
# Use Case: Authenticate as an Inventory Manager (can approve transfers, manage master data).
# @name managerLogin
POST {{IMS_API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "userNameOrEmail": "manager",
  "password": "ManagerPassword123!"
}

### Store Manager Token
@managerToken = {{managerLogin.response.body.token}}


### 1.3 Login as Warehouse Staff
# Use Case: Authenticate as warehouse floor staff (create PO/SO, submit transfers, record stock adjustments).
# @name staffLogin
POST {{IMS_API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "userNameOrEmail": "staff",
  "password": "StaffPassword123!"
}

### Store Staff Token
@staffToken = {{staffLogin.response.body.token}}


### 1.4 Register a New Self-Service User
# Use Case: Public self-registration endpoint for a new employee or customer user.
# @name registerUser
POST {{IMS_API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "userName": "auditor_clara",
  "email": "clara@ims.com",
  "password": "Password123!",
  "fullName": "Clara Oswald"
}


### 1.5 Get Current User Profile (/me)
# Use Case: Fetch currently authenticated user's profile details and assigned roles.
GET {{IMS_API_HostAddress}}/api/auth/me
Authorization: Bearer {{adminToken}}


### 1.6 Refresh JWT Token
# Use Case: Exchange an expired JWT access token using a valid active refresh token.
# @name refreshTokenCall
POST {{IMS_API_HostAddress}}/api/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{adminRefreshToken}}"
}


### 1.7 Revoke Refresh Token (Logout / Session Kill)
# Use Case: Invalidate a refresh token when logging out or upon security compromise.
POST {{IMS_API_HostAddress}}/api/auth/revoke-token
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "refreshToken": "{{adminRefreshToken}}"
}


### ===================================================================
### 2. ROLE MANAGEMENT (Admin Only)
### ===================================================================

### 2.1 Get All Roles
# Use Case: Retrieve all application security roles available in the system.
GET {{IMS_API_HostAddress}}/api/roles
Authorization: Bearer {{adminToken}}


### 2.2 Create a New Custom Role
# Use Case: Create an enterprise custom role (e.g., "Auditor" or "ProcurementOfficer").
# @name createRole
POST {{IMS_API_HostAddress}}/api/roles
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Auditor",
  "description": "Inventory auditor with read and physical count audit privileges"
}

### Store Role ID
@auditorRoleId = {{createRole.response.body.id}}


### 2.3 Get Role by ID
# Use Case: Query details of a specific role by its GUID identifier.
GET {{IMS_API_HostAddress}}/api/roles/{{auditorRoleId}}
Authorization: Bearer {{adminToken}}


### 2.4 Update Role
# Use Case: Modify role name or descriptive scope.
PUT {{IMS_API_HostAddress}}/api/roles/{{auditorRoleId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Auditor",
  "description": "Senior inventory compliance auditor"
}


### 2.5 Delete Role
# Use Case: Permanently delete an obsolete role (cannot delete if users are assigned).
DELETE {{IMS_API_HostAddress}}/api/roles/{{auditorRoleId}}
Authorization: Bearer {{adminToken}}


### ===================================================================
### 3. USER MANAGEMENT (Admin & Manager)
### ===================================================================

### 3.1 Get All Users
# Use Case: Fetch all active users (pass ?includeInactive=true to see deactivated accounts).
GET {{IMS_API_HostAddress}}/api/users?includeInactive=true
Authorization: Bearer {{adminToken}}


### 3.2 Create a New User With Initial Role(s)
# Use Case: Admin/Manager provisions a new staff member with one or more assigned roles.
# @name createUser
POST {{IMS_API_HostAddress}}/api/users
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "userName": "sarah_warehouse",
  "email": "sarah.connor@ims.com",
  "password": "Password123!",
  "fullName": "Sarah Connor",
  "phoneNumber": "+1-555-0199",
  "roles": [
    "WarehouseStaff"
  ]
}

### Store New User ID
@newUserId = {{createUser.response.body.id}}


### 3.3 Get User by ID
# Use Case: View complete user profile, activation status, and role assignments.
GET {{IMS_API_HostAddress}}/api/users/{{newUserId}}
Authorization: Bearer {{adminToken}}


### 3.4 Update User Profile
# Use Case: Update user's personal information (Email, Full Name, Phone).
PUT {{IMS_API_HostAddress}}/api/users/{{newUserId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "sarah.updated@ims.com",
  "fullName": "Sarah Connor-Smith",
  "phoneNumber": "+1-555-9911"
}


### 3.5 Reassign / Replace User Roles (Admin Only)
# Use Case: Promote or change a user's roles (e.g. promote staff to Manager).
PUT {{IMS_API_HostAddress}}/api/users/{{newUserId}}/roles
Content-Type: application/json
Authorization: Bearer {{adminToken}}

[
  "Manager",
  "WarehouseStaff"
]


### 3.6 Deactivate User Account (Admin Only)
# Use Case: Terminate or suspend user access without losing historic audit trails.
PATCH {{IMS_API_HostAddress}}/api/users/{{newUserId}}/deactivate
Authorization: Bearer {{adminToken}}


### 3.7 Reactivate User Account (Admin Only)
# Use Case: Restore account access to a previously suspended user.
PATCH {{IMS_API_HostAddress}}/api/users/{{newUserId}}/reactivate
Authorization: Bearer {{adminToken}}


### ===================================================================
### 4. CATEGORIES
### ===================================================================

### 4.1 Get All Categories
# Use Case: Retrieve complete list of product categories for catalog navigation/dropdowns.
GET {{IMS_API_HostAddress}}/api/categories
Authorization: Bearer {{staffToken}}


### 4.2 Create Category (Admin / Manager)
# Use Case: Create a new inventory classification category.
# @name createCategory
POST {{IMS_API_HostAddress}}/api/categories
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
  "name": "Network & Telecom",
  "description": "Routers, enterprise firewalls, and fiber cabling accessories"
}

### Store Category ID
@categoryId = {{createCategory.response.body.id}}


### 4.3 Get Category by ID
# Use Case: Fetch specific category metadata.
GET {{IMS_API_HostAddress}}/api/categories/{{categoryId}}
Authorization: Bearer {{staffToken}}


### 4.4 Update Category (Admin / Manager)
# Use Case: Rename or modify category description.
PUT {{IMS_API_HostAddress}}/api/categories/{{categoryId}}
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
  "name": "Enterprise Networking & Security",
  "description": "High-throughput firewalls, managed switches, and optics"
}


### 4.5 Delete Category (Admin / Manager)
# Use Case: Remove an empty category that has no linked products.
DELETE {{IMS_API_HostAddress}}/api/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}


### ===================================================================
### 5. WAREHOUSES
### ===================================================================

### 5.1 Get All Warehouses
# Use Case: List all operating warehouse facilities.
GET {{IMS_API_HostAddress}}/api/warehouses?includeInactive=false
Authorization: Bearer {{staffToken}}


### 5.2 Create Warehouse (Admin / Manager)
# Use Case: Register a new distribution center or stock storage location.
# @name createWarehouse
POST {{IMS_API_HostAddress}}/api/warehouses
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
  "name": "South Distribution Hub",
  "code": "WH-SOUTH",
  "location": "Dallas, TX - Zone 4",
  "description": "Primary fulfillment facility for Southern regional shipments"
}

### Store Warehouse ID
@warehouseId = {{createWarehouse.response.body.id}}


### 5.3 Get Warehouse by ID
# Use Case: Query warehouse details and address.
GET {{IMS_API_HostAddress}}/api/warehouses/{{warehouseId}}
Authorization: Bearer {{staffToken}}


### 5.4 Update Warehouse Details (Admin / Manager)
# Use Case: Update warehouse name, location address, or internal notes.
PUT {{IMS_API_HostAddress}}/api/warehouses/{{warehouseId}}
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
  "name": "South Mega Distribution Hub",
  "location": "Dallas, TX - Bay 12 Expanded",
  "description": "Expanded facility with 40,000 pallet capacity"
}


### 5.5 Deactivate Warehouse (Admin / Manager)
# Use Case: Mark warehouse facility inactive during renovations or closure.
PATCH {{IMS_API_HostAddress}}/api/warehouses/{{warehouseId}}/deactivate
Authorization: Bearer {{adminToken}}


### 5.6 Reactivate Warehouse (Admin / Manager)
# Use Case: Reopen an inactive warehouse for operations.
PATCH {{IMS_API_HostAddress}}/api/warehouses/{{warehouseId}}/reactivate
Authorization: Bearer {{adminToken}}


### ===================================================================
### 6. SUPPLIERS
### ===================================================================

### 6.1 Get All Suppliers
# Use Case: List active procurement vendors.
GET {{IMS_API_HostAddress}}/api/suppliers
Authorization: Bearer {{staffToken}}


### 6.2 Search Suppliers by Term
# Use Case: Instant vendor lookup by name, email, or telephone.
GET {{IMS_API_HostAddress}}/api/suppliers/search?term=Tech
Authorization: Bearer {{staffToken}}


